input {
    keyboard {
        xkb {
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }

    mouse {
    }

    trackpoint {
    }

    focus-follows-mouse max-scroll-amount="0%"
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
animations {
    // Uncomment to turn off all animations.
    // off
    // slowdown 3.0
}

debug {
  honor-xdg-activation-with-invalid-serial
}

include "./config/cursor.kdl"
include "./config/environment.kdl"
include "./config/keybinds.kdl"
include "./config/layout.kdl"
include "./config/output.kdl"
include "./config/startup.kdl"
include "./config/windowrules.kdl"

